{
  "rules": {
    ".read": false,
    ".write": false,
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['stats']) || !newData.exists()"
      }
    },
    "rooms": {
      "$code": {
        ".validate": "$code.matches(/^[A-Z2-9]{4,6}$/)",
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('meta/host').val() === auth.uid)",
        "meta": {
          ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid)",
          "host": { ".validate": "newData.isString() && (data.exists() ? data.val() === newData.val() : newData.val() === auth.uid)" }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms/' + $code + '/meta/host').val() === auth.uid)",
            ".validate": "!newData.exists() || (newData.child('slot').isNumber() && newData.child('slot').val() >= 0 && newData.child('slot').val() <= 3)"
          }
        },
        "signal": {
          "$to": {
            ".read": "auth != null && auth.uid === $to",
            "$msg": {
              ".write": "auth != null && (auth.uid === $to || newData.child('from').val() === auth.uid)",
              ".validate": "!newData.exists() || newData.child('from').val() === auth.uid"
            }
          }
        },
        "relay": {
          "$to": {
            ".read": "auth != null && auth.uid === $to",
            "$msg": {
              ".write": "auth != null && (auth.uid === $to || newData.child('from').val() === auth.uid)",
              ".validate": "!newData.exists() || (newData.child('from').val() === auth.uid && newData.child('d').isString() && newData.child('d').val().length < 4096)"
            }
          }
        }
      }
    }
  }
}
