; Lumos Party & Nitro Dash – Godot 4 Projekt
config_version=5

[application]

config/name="Lumos Party & Nitro Dash"
config/description="3D-Party-Brettspiel mit 10 Minispielen und Arcade-Racer für Lumos OS"
config/version="1.1.1"
run/main_scene="res://scenes/boot/Boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.07, 0.04, 0.16, 1)
boot_splash/show_image=false
config/icon="res://assets/brand/icon.png"

[autoload]

EventBus="*res://autoload/event_bus.gd"
Game="*res://autoload/game_state.gd"
Assets="*res://autoload/assets.gd"
Audio="*res://autoload/audio_manager.gd"
InputHub="*res://autoload/input_hub.gd"
Juice="*res://autoload/juice.gd"
FX="*res://autoload/fx.gd"
CutsceneManager="*res://autoload/cutscene_manager.gd"
Router="*res://autoload/scene_router.gd"
Account="*res://autoload/account.gd"
Avatars="*res://autoload/avatars.gd"
Net="*res://autoload/net.gd"
Gfx="*res://autoload/gfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[importer_defaults]

texture={
"compress/mode": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": true
}

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.07, 0.04, 0.16, 1)
textures/canvas_textures/default_texture_filter=1
